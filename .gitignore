# Build output
bin/
obj/

# Runtime data (uploads, jobs, results)
data/
# User-saved scripts (the versioned seeds live in scripts-library/, which IS tracked)
data/scripts/

# Python
__pycache__/
*.pyc

# IDE / user
*.user
.vs/
.idea/

# NuGet package produced by PicoGK GeneratePackageOnBuild
*.nupkg

# Publish output (dotnet publish -o ..., or bin/**/publish)
publish/

# Scratch / temp files
*.tmp
scratch/
