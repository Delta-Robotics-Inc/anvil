<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>AnvilWorker</AssemblyName>
    <RootNamespace>Anvil.Worker</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Sibling PicoGK fork (local patched source, not NuGet). Relative path
         resolves to C:\Users\Kev\Desktop\Repos\PicoGK\src\PicoGK.csproj from
         C:\Users\Kev\Desktop\Repos\anvil\worker\ -->
    <ProjectReference Include="..\..\PicoGK\src\PicoGK.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- In-app C# scripting (LEAP71-style code-to-geometry): the worker compiles
         and runs user .csx against the PicoGK + Anvil.Worker APIs in a per-job
         process. Worker-ONLY (the server never references Roslyn or PicoGK). -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="4.14.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copy PicoGK native runtime DLLs next to the worker exe so it does not
         depend on the System32-installed copy. -->
    <None Include="..\..\PicoGK\runtime\native\win-x64\*.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
