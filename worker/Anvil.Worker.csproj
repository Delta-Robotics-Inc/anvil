<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>AnvilWorker</AssemblyName>
    <RootNamespace>Anvil.Worker</RootNamespace>

    <!-- Emit AnvilWorker.xml so the Forge command reference (units, defaults and
         meaning of every modifier) is machine-readable for doc generation.
         CS1591 is silenced: only the Forge scripting surface is documented, not
         every internal DTO property. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Sibling PicoGK fork (local patched source, not NuGet). Relative path
         resolves to C:\Users\Kev\Desktop\Repos\PicoGK\src\PicoGK.csproj from
         C:\Users\Kev\Desktop\Repos\anvil\worker\ -->
    <ProjectReference Include="..\..\PicoGK\src\PicoGK.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- In-app C# scripting (LEAP71-style code-to-geometry): the worker compiles
         and runs user .csx against the PicoGK + Anvil.Worker APIs in a per-job
         process. Worker-ONLY (the server never references Roslyn or PicoGK). -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="4.14.0" />

    <!-- Raster decoding for Forge.Emboss (PNG/JPG/BMP depth maps). GDI+, so
         Windows-only, which Anvil already is; the two call sites in ForgeSdf.cs
         are wrapped in #pragma warning disable CA1416. -->
    <PackageReference Include="System.Drawing.Common" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copy PicoGK native runtime DLLs next to the worker exe so it does not
         depend on the System32-installed copy. -->
    <None Include="..\..\PicoGK\runtime\native\win-x64\*.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
