<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>InfillWorker</AssemblyName>
    <RootNamespace>InfillWorker</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Sibling PicoGK fork (local patched source, not NuGet). Relative path
         resolves to C:\Users\Kev\Desktop\Repos\PicoGK\src\PicoGK.csproj from
         C:\Users\Kev\Desktop\Repos\infill-app\worker\ -->
    <ProjectReference Include="..\..\PicoGK\src\PicoGK.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copy PicoGK native runtime DLLs next to the worker exe so it does not
         depend on the System32-installed copy. -->
    <None Include="..\..\PicoGK\runtime\native\win-x64\*.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
